<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (API 23–30). The signed-in email lives in EncryptedSharedPreferences
     and the SQLite cache can hold other players' names; none of that should leave
     the device. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
